[{"id":"jp-n5-001","kana":"わたし","romaji":"watashi","meaning":"나, 저","level":"N5","example":{"jp":"私は学生です。","reading":"Watashi wa gakusei desu.","meaning":"저는 학생입니다."},"kanji":"私"},{"id":"jp-n5-002","kana":"あなた","romaji":"anata","meaning":"당신, 너","level":"N5","example":{"jp":"あなたは日本人ですか。","reading":"Anata wa nihonjin desu ka.","meaning":"당신은 일본인입니까?"}},{"id":"jp-n5-003","kana":"がくせい","romaji":"gakusei","meaning":"학생","level":"N5","example":{"jp":"私は大学の学生です。","reading":"Watashi wa daigaku no gakusei desu.","meaning":"저는 대학생입니다."},"kanji":"学生"},{"id":"jp-n5-004","kana":"せんせい","romaji":"sensei","meaning":"선생님","level":"N5","example":{"jp":"田中先生はやさしいです。","reading":"Tanaka sensei wa yasashii desu.","meaning":"다나카 선생님은 상냥합니다."},"kanji":"先生"},{"id":"jp-n5-005","kana":"ともだち","romaji":"tomodachi","meaning":"친구","level":"N5","example":{"jp":"友達と映画を見ます。","reading":"Tomodachi to eiga o mimasu.","meaning":"친구와 영화를 봅니다."},"kanji":"友達"},{"id":"jp-n5-006","kana":"かぞく","romaji":"kazoku","meaning":"가족","level":"N5","example":{"jp":"私の家族は四人です。","reading":"Watashi no kazoku wa yonin desu.","meaning":"우리 가족은 네 명입니다."},"kanji":"家族"},{"id":"jp-n5-007","kana":"なまえ","romaji":"namae","meaning":"이름","level":"N5","example":{"jp":"お名前は何ですか。","reading":"Onamae wa nan desu ka.","meaning":"이름이 무엇입니까?"},"kanji":"名前"},{"id":"jp-n5-008","kana":"にほん","romaji":"nihon","meaning":"일본","level":"N5","example":{"jp":"日本へ行きたいです。","reading":"Nihon e ikitai desu.","meaning":"일본에 가고 싶습니다."},"kanji":"日本"},{"id":"jp-n5-009","kana":"かんこく","romaji":"kankoku","meaning":"한국","level":"N5","example":{"jp":"私は韓国から来ました。","reading":"Watashi wa kankoku kara kimashita.","meaning":"저는 한국에서 왔습니다."},"kanji":"韓国"},{"id":"jp-n5-010","kana":"くに","romaji":"kuni","meaning":"나라","level":"N5","example":{"jp":"あなたの国はどこですか。","reading":"Anata no kuni wa doko desu ka.","meaning":"당신의 나라는 어디입니까?"},"kanji":"国"},{"id":"jp-n5-011","kana":"がっこう","romaji":"gakkō","meaning":"학교","level":"N5","example":{"jp":"毎日学校へ行きます。","reading":"Mainichi gakkō e ikimasu.","meaning":"매일 학교에 갑니다."},"kanji":"学校"},{"id":"jp-n5-012","kana":"かいしゃ","romaji":"kaisha","meaning":"회사","level":"N5","example":{"jp":"父は会社で働いています。","reading":"Chichi wa kaisha de hataraite imasu.","meaning":"아버지는 회사에서 일하십니다."},"kanji":"会社"},{"id":"jp-n5-013","kana":"いえ","romaji":"ie","meaning":"집","level":"N5","example":{"jp":"家で本を読みます。","reading":"Ie de hon o yomimasu.","meaning":"집에서 책을 읽습니다."},"kanji":"家"},{"id":"jp-n5-014","kana":"へや","romaji":"heya","meaning":"방","level":"N5","example":{"jp":"私の部屋は広いです。","reading":"Watashi no heya wa hiroi desu.","meaning":"제 방은 넓습니다."},"kanji":"部屋"},{"id":"jp-n5-015","kana":"みせ","romaji":"mise","meaning":"가게","level":"N5","example":{"jp":"あの店は安いです。","reading":"Ano mise wa yasui desu.","meaning":"저 가게는 쌉니다."},"kanji":"店"},{"id":"jp-n5-016","kana":"えき","romaji":"eki","meaning":"역","level":"N5","example":{"jp":"駅まで歩きます。","reading":"Eki made arukimasu.","meaning":"역까지 걷습니다."},"kanji":"駅"},{"id":"jp-n5-017","kana":"でんしゃ","romaji":"densha","meaning":"전철","level":"N5","example":{"jp":"電車で会社へ行きます。","reading":"Densha de kaisha e ikimasu.","meaning":"전철로 회사에 갑니다."},"kanji":"電車"},{"id":"jp-n5-018","kana":"くるま","romaji":"kuruma","meaning":"자동차","level":"N5","example":{"jp":"車を運転します。","reading":"Kuruma o unten shimasu.","meaning":"자동차를 운전합니다."},"kanji":"車"},{"id":"jp-n5-019","kana":"みち","romaji":"michi","meaning":"길","level":"N5","example":{"jp":"この道はまっすぐです。","reading":"Kono michi wa massugu desu.","meaning":"이 길은 곧습니다."},"kanji":"道"},{"id":"jp-n5-020","kana":"みず","romaji":"mizu","meaning":"물","level":"N5","example":{"jp":"水を一杯ください。","reading":"Mizu o ippai kudasai.","meaning":"물 한 잔 주세요."},"kanji":"水"},{"id":"jp-n5-021","kana":"おちゃ","romaji":"ocha","meaning":"차(茶)","level":"N5","example":{"jp":"お茶を飲みませんか。","reading":"Ocha o nomimasen ka.","meaning":"차를 마시지 않겠어요?"},"kanji":"お茶"},{"id":"jp-n5-022","kana":"ごはん","romaji":"gohan","meaning":"밥","level":"N5","example":{"jp":"朝ご飯を食べました。","reading":"Asa gohan o tabemashita.","meaning"