id":"jp-n5-034","kana":"とし","romaji":"toshi","meaning":"해, 나이","level":"N5","example":{"jp":"来年日本へ行きます。","reading":"Rainen nihon e ikimasu.","meaning":"내년에 일본에 갑니다."},"kanji":"年"},{"id":"jp-n5-035","kana":"てんき","romaji":"tenki","meaning":"날씨","level":"N5","example":{"jp":"天気がいいですね。","reading":"Tenki ga ii desu ne.","meaning":"날씨가 좋네요."},"kanji":"天気"},{"id":"jp-n5-036","kana":"あめ","romaji":"ame","meaning":"비","level":"N5","example":{"jp":"雨が降っています。","reading":"Ame ga futte imasu.","meaning":"비가 내리고 있습니다."},"kanji":"雨"},{"id":"jp-n5-037","kana":"ゆき","romaji":"yuki","meaning":"눈(雪)","level":"N5","example":{"jp":"雪が好きですか。","reading":"Yuki ga suki desu ka.","meaning":"눈을 좋아합니까?"},"kanji":"雪"},{"id":"jp-n5-038","kana":"いぬ","romaji":"inu","meaning":"개","level":"N5","example":{"jp":"犬と散歩します。","reading":"Inu to sanpo shimasu.","meaning":"개와 산책합니다."},"kanji":"犬"},{"id":"jp-n5-039","kana":"ねこ","romaji":"neko","meaning":"고양이","level":"N5","example":{"jp":"猫がかわいいです。","reading":"Neko ga kawaii desu.","meaning":"고양이가 귀엽습니다."},"kanji":"猫"},{"id":"jp-n5-040","kana":"ほん","romaji":"hon","meaning":"책","level":"N5","example":{"jp":"図書館で本を借ります。","reading":"Toshokan de hon o karimasu.","meaning":"도서관에서 책을 빌립니다."},"kanji":"本"},{"id":"jp-n5-041","kana":"しんぶん","romaji":"shinbun","meaning":"신문","level":"N5","example":{"jp":"毎朝新聞を読みます。","reading":"Maiasa shinbun o yomimasu.","meaning":"매일 아침 신문을 읽습니다."},"kanji":"新聞"},{"id":"jp-n5-042","kana":"てがみ","romaji":"tegami","meaning":"편지","level":"N5","example":{"jp":"友達に手紙を書きます。","reading":"Tomodachi ni tegami o kakimasu.","meaning":"친구에게 편지를 씁니다."},"kanji":"手紙"},{"id":"jp-n5-043","kana":"えいが","romaji":"eiga","meaning":"영화","level":"N5","example":{"jp":"週末に映画を見ます。","reading":"Shūmatsu ni eiga o mimasu.","meaning":"주말에 영화를 봅니다."},"kanji":"映画"},{"id":"jp-n5-044","kana":"おんがく","romaji":"ongaku","meaning":"음악","level":"N5","example":{"jp":"音楽を聞くのが好きです。","reading":"Ongaku o kiku no ga suki desu.","meaning":"음악 듣는 것을 좋아합니다."},"kanji":"音楽"},{"id":"jp-n5-045","kana":"しごと","romaji":"shigoto","meaning":"일, 업무","level":"N5","example":{"jp":"仕事が忙しいです。","reading":"Shigoto ga isogashii desu.","meaning":"일이 바쁩니다."},"kanji":"仕事"},{"id":"jp-n5-046","kana":"たべる","romaji":"taberu","meaning":"먹다","level":"N5","example":{"jp":"朝ご飯を食べます。","reading":"Asa gohan o tabemasu.","meaning":"아침밥을 먹습니다."},"kanji":"食べる"},{"id":"jp-n5-047","kana":"のむ","romaji":"nomu","meaning":"마시다","level":"N5","example":{"jp":"水を飲みます。","reading":"Mizu o nomimasu.","meaning":"물을 마십니다."},"kanji":"飲む"},{"id":"jp-n5-048","kana":"みる","romaji":"miru","meaning":"보다","level":"N5","example":{"jp":"テレビを見ます。","reading":"Terebi o mimasu.","meaning":"텔레비전을 봅니다."},"kanji":"見る"},{"id":"jp-n5-049","kana":"きく","romaji":"kiku","meaning":"듣다, 묻다","level":"N5","example":{"jp":"音楽を聞きます。","reading":"Ongaku o kikimasu.","meaning":"음악을 듣습니다."},"kanji":"聞く"},{"id":"jp-n5-050","kana":"よむ","romaji":"yomu","meaning":"읽다","level":"N5","example":{"jp":"本を読みます。","reading":"Hon o yomimasu.","meaning":"책을 읽습니다."},"kanji":"読む"},{"id":"jp-n5-051","kana":"かく","romaji":"kaku","meaning":"쓰다","level":"N5","example":{"jp":"名前を書いてください。","reading":"Namae o kaite kudasai.","meaning":"이름을 써 주세요."},"kanji":"書く"},{"id":"jp-n5-052","kana":"はなす","romaji":"hanasu","meaning":"말하다, 이야기하다","level":"N5","example":{"jp":"日本語を話します。","reading":"Nihongo o hanashimasu.","meaning":"일본어를 말합니다."},"kanji":"話す"},{"id":"jp-n5-053","kana":"いく","romaji":"iku","meaning":"가다","level":"N5","example":{"jp":"学校へ行きます。","reading":"Gakkō e ikimasu.","meaning":"학교에 갑니다."},"kanji":"行く"},{"id":"jp-n5-054","kana":"くる","romaji":"kuru","meaning":"오다","level":"N5","example":{"jp":"友達が来ます。","reading":"Tomodachi ga kimasu.","meaning":"친구가 옵니다."},"kanji":"来る"},{"id":"jp-n5-055","kana":"かえる","romaji":"kaeru","meaning":"돌아가다/오다","level":"N5","example":{"jp":"家へ帰ります。","reading":"Ie e kaerimasu.","meaning":"집에 돌아갑니다."},"kanji":"帰る"},{"id":"jp-n5-056","kana":"かう","romaji":"kau","meaning":"사다","level":"N5","example":{"jp":"くだものを買います。","reading":"Ku